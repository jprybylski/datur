{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Datum Configuration",
  "type": "object",
  "required": ["version", "datasets"],
  "properties": {
    "version": {"type": "integer", "enum": [1]},
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "desc", "target"],
        "oneOf": [{"required": ["source"]}, {"required": ["sources"]}],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"},
          "desc": {"type": "string"},
          "source": {"oneOf": [{"$ref": "#/definitions/httpSource"}, {"$ref": "#/definitions/fileSource"}]},
          "sources": {"type": "array", "minItems": 1, "items": {"oneOf": [{"$ref": "#/definitions/httpSource"}, {"$ref": "#/definitions/fileSource"}]}},
          "target": {"type": "string"},
          "policy": {"type": "string", "enum": ["fail", "update", "log"]},
          "ignore": {"type": "boolean"}
        }
      }
    }
  },
  "definitions": {
    "httpSource": {
      "type": "object",
      "required": ["type", "url"],
      "properties": {
        "type": {"type": "string", "enum": ["http"]},
        "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
        "headers": {"type": "object", "additionalProperties": {"type": "string"}},
        "body": {"type": "string"}
      },
      "additionalProperties": false
    },
    "fileSource": {
      "type": "object",
      "required": ["type", "path"],
      "properties": {
        "type": {"type": "string", "enum": ["file"]},
        "path": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
