{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Datum Configuration",
  "type": "object",
  "required": ["version", "datasets"],
  "properties": {
    "version": {"type": "integer", "enum": [1]},
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "desc", "target"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"},
          "desc": {"type": "string"},
          "source": {"type": "object"},
          "sources": {"type": "array"},
          "target": {"type": "string"},
          "policy": {"type": "string", "enum": ["fail", "update", "log"]}
        }
      }
    }
  }
}
